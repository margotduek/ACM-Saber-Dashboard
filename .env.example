# Copia este archivo a .env y rellena los valores para trabajo LOCAL.
# En remoto (Claude Code en la web) NO uses este archivo: configura estas
# mismas variables como secrets/variables de entorno del entorno de ejecución.
# El archivo .env real está en .gitignore y nunca se sube al repo público.

# Meta / Facebook Ads
ACCESS_TOKEN=
AD_ACCOUNT_ID=

# Shopify
SHOPIFY_STORE=
SHOPIFY_TOKEN=
